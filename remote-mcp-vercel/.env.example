# Paste the complete contents of a NEW Firebase service-account JSON key as one line.
# Use ONE of the following. Base64 is easier and safer to paste into Vercel.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id"}
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# OAuth authorization server. Generate a 32+ character random value.
MCP_OAUTH_SIGNING_SECRET=replace_with_a_long_random_secret

# The administrator identity that is allowed to authorize Claude.
MCP_ADMIN_EMAIL=admin@example.com
# Generate with: npm run hash:admin-password
MCP_ADMIN_PASSWORD_HASH=scrypt$replace_with_generated_hash

# Your final Vercel production URL, without a trailing slash.
MCP_PUBLIC_ORIGIN=https://your-project.vercel.app
