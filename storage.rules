rules_version = '2';
service firebase.storage { match /b/{bucket}/o { function signedIn() { return request.auth != null; } function user() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; } match /clinics/{clinicId}/{allPaths=**} { allow read: if signedIn() && user().clinicId == clinicId; allow write: if signedIn() && user().clinicId == clinicId && user().role in ['SUPER_ADMIN','CLINIC_ADMIN','DOCTOR']; } } }
