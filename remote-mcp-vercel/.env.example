# Use ONE Firebase credential variable only. Never paste a real credential into this tracked file.
# Recommended for Vercel: paste Base64 of a newly-created service-account JSON into Vercel only.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
# Alternative: paste raw JSON into Vercel only. Leave blank when using Base64.
FIREBASE_SERVICE_ACCOUNT_JSON=

# OAuth authorization server. Generate a unique random value of at least 32 characters.
MCP_OAUTH_SIGNING_SECRET=

# The administrator identity that is allowed to authorize Claude.
MCP_ADMIN_EMAIL=
# Generate locally with: npm run mcp:hash-admin-password
MCP_ADMIN_PASSWORD_HASH=

# Final Vercel production URL, without a trailing slash.
MCP_PUBLIC_ORIGIN=https://your-project.vercel.app
